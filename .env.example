# Variables del entorno Docker de desarrollo de la extensión.
# Copiar este archivo como .env y completar los valores: cp .env.example .env
# .env no se sube al repositorio. Usar contraseñas propias y no reutilizarlas en otros entornos.
# Las variables comentadas (#) son opcionales: sin definirlas se usa el valor que muestran.

# =====================================================================================
# Servidor MySQL
# Un solo servidor con dos bases: la de Providence y la de la extensión.
# Desde esta computadora (DBeaver, etc.): host 127.0.0.1, puerto DB_PORT.
# DB_PORT: 3307 para no chocar con un MySQL instalado localmente (que suele usar 3306).
# Usuario root (solo para administrar MySQL): contraseña MYSQL_ROOT_PASSWORD.
# =====================================================================================
MYSQL_ROOT_PASSWORD=
DB_PORT=3307

# =====================================================================================
# Base de Providence
# La usa Providence. Conexión desde DBeaver: base CA_DB_DATABASE, usuario CA_DB_USER,
# contraseña CA_DB_PASSWORD.
# =====================================================================================
CA_DB_DATABASE=collectiveaccess
CA_DB_USER=ca
CA_DB_PASSWORD=

# =====================================================================================
# Base de la extensión (servicio Rust)
# La usa solo el servicio Rust; su usuario no tiene acceso a la base de Providence.
# Conexión desde DBeaver: base EXT_DB_DATABASE, usuario EXT_DB_USER, contraseña EXT_DB_PASSWORD.
# Nombre y usuario: letras, números y guion bajo, distintos de CA_DB_DATABASE y CA_DB_USER.
# Contraseña obligatoria, sin comillas simples ni barras invertidas.
# =====================================================================================
EXT_DB_DATABASE=ca_extension
EXT_DB_USER=ca_extension
EXT_DB_PASSWORD=

# =====================================================================================
# Usuario administrador de Providence (para ingresar en http://localhost:PROVIDENCE_PORT)
# CA_ADMIN_USERNAME: letras, números, punto, guion y guion bajo.
# CA_ADMIN_PASSWORD: debe cumplir la política de Providence (por defecto, al menos 6 caracteres).
# =====================================================================================
CA_ADMIN_USERNAME=
CA_ADMIN_EMAIL=
CA_ADMIN_PASSWORD=

# =====================================================================================
# Providence (opcionales)
# =====================================================================================
# PROVIDENCE_PORT=8080
# Zona horaria de los contenedores (fechas de Providence, de MySQL y de la extensión)
# TZ=America/Argentina/Buenos_Aires
# CA_INSTALL_PROFILE=default
# CA_DEFAULT_LOCALE=en_US

# =====================================================================================
# Módulo 6: fuentes externas (opcionales). Vacía = la fuente queda "sin configurar" y no entra
# en "Todas las fuentes". Ver docs/modulo6/fuentes.md
# =====================================================================================
# Tiempo máximo de cada pedido a una fuente, en milisegundos (MultiSource corta a los 5 s)
# M6_TIMEOUT_MS=2500
# Colección Numishare de la fuente "numishare" (por defecto OCRE)
# M6_NUMISHARE_URL=http://numismatics.org/crro/
# Clave opcional de Encyclopedia of Life
# M6_EOL_CLAVE=
# Fuentes taxonómicas de Global Names (1 = Catalogue of Life; vacía = todas)
# M6_GLOBALNAMES_FUENTES=1
# Fuente SPARQL genérica (por defecto, Wikidata). La consulta usa ***PLACEHOLDER*** y ***IDIOMA***
# M6_SPARQL_URL=https://query.wikidata.org/sparql
# M6_SPARQL_CONSULTA=
# M6_SPARQL_VAR_URI=item
# M6_SPARQL_VAR_ETIQUETA=itemLabel
# Otra instalación de CollectiveAccess
# M6_CA_URL=
# M6_CA_USUARIO=
# M6_CA_CLAVE=
# M6_CA_TABLA=ca_entities
# M6_CA_PLANTILLA=
# ResourceSpace
# M6_RS_URL=
# M6_RS_USUARIO=
# M6_RS_CLAVE=
# WorldCat (clave wskey de OCLC)
# M6_WORLDCAT_CLAVE=