# Traducciones propias de la instalación para sv_SE: los textos del tema ModernUI (diálogo al salir sin
# guardar y ajustes de las pantallas de Providence). Providence las carga además de app/locale/sv_SE.
# messages.mo se genera desde este archivo con gettext: msgfmt messages.po -o messages.mo
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: sv_SE\n"

msgid "Leave without saving?"
msgstr "Lämna utan att spara?"

msgid "This form has changes that are not saved. If you leave the page, they are discarded."
msgstr "Det här formuläret har ändringar som inte är sparade. Om du lämnar sidan förkastas de."

msgid "Keep editing"
msgstr "Fortsätt redigera"

msgid "Leave without saving"
msgstr "Lämna utan att spara"

msgid "Type * to see all the records."
msgstr "Skriv * för att se alla poster."

msgid "The record was added to your watched items."
msgstr "Posten lades till bland dina bevakade poster."

msgid "The record was removed from your watched items."
msgstr "Posten togs bort från dina bevakade poster."

msgid "Filter…"
msgstr "Filtrera…"
