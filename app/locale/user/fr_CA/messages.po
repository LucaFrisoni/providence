# Traducciones propias de la instalación para fr_CA: los textos del tema ModernUI (diálogo al salir sin
# guardar y ajustes de las pantallas de Providence). Providence las carga además de app/locale/fr_CA.
# messages.mo se genera desde este archivo con gettext: msgfmt messages.po -o messages.mo
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
