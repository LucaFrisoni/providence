msgid "Click %1 names to explore. Click on an arrow icon to open a %1 for editing."
msgstr "Κάντε κλικ στα ονόματα (%1) για εξερεύνηση. Κάντε κλικ σε ένα βέλος για να ανοίξετε μια εγγραφή (%1) για επεξεργασία."

msgid "Use the controls below to create new %1 relative to this record in the hierarchy."
msgstr "Χρησιμοποιήστε τα παρακάτω στοιχεία ελέγχου για να δημιουργήσετε νέες εγγραφές (%1) σε σχέση με αυτή την εγγραφή στην ιεραρχία."

msgid "Use the controls below to create new %1 relative to this %2 in the hierarchy."
msgstr "Χρησιμοποιήστε τα παρακάτω στοιχεία ελέγχου για να δημιουργήσετε νέες εγγραφές (%1) σε σχέση με αυτή την εγγραφή (%2) στην ιεραρχία."

msgid "Create child record under this %1"
msgstr "Δημιουργία θυγατρικής εγγραφής κάτω από αυτή την εγγραφή (%1)"

msgid "Change %1 type"
msgstr "Αλλαγή τύπου (%1)"

