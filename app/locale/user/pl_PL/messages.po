# Traducciones propias de la instalación para pl_PL: los textos del tema ModernUI (diálogo al salir sin
# guardar y ajustes de las pantallas de Providence). Providence las carga además de app/locale/pl_PL.
# messages.mo se genera desde este archivo con gettext: msgfmt messages.po -o messages.mo
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: pl_PL\n"

msgid "Leave without saving?"
msgstr "Wyjść bez zapisywania?"

msgid "This form has changes that are not saved. If you leave the page, they are discarded."
msgstr "Ten formularz zawiera niezapisane zmiany. Jeśli opuścisz stronę, zostaną odrzucone."

msgid "Keep editing"
msgstr "Kontynuuj edycję"

msgid "Leave without saving"
msgstr "Wyjdź bez zapisywania"

msgid "Type * to see all the records."
msgstr "Wpisz *, aby zobaczyć wszystkie rekordy."

msgid "The record was added to your watched items."
msgstr "Rekord został dodany do obserwowanych."

msgid "The record was removed from your watched items."
msgstr "Rekord został usunięty z obserwowanych."

msgid "Filter…"
msgstr "Filtruj…"

